{
    "manifest_version": 3,
    "name": "Gmail Sorter",
    "version": "3.0",
    "description": "Categorize Gmail emails",
    "content_scripts": [
        {
            "matches": ["https://mail.google.com/*"],
            "js": ["prevent-reload.js"],
            "world": "MAIN",
            "run_at": "document_start"
        },
        {
            "matches": ["https://mail.google.com/*"],
            "css": ["style.css"],
            "js": ["content.js"]
        }
    ]
}